{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases
 {:run {:main-opts ["-m" "DrClojure.core"]}
   :test {:extra-paths ["test"]
          :main-opts ["-e" "(require 'clojure.test 'DrClojure.eval-test 'DrClojure.core-test 'DrClojure.syntax-test) (let [res (clojure.test/run-tests 'DrClojure.eval-test 'DrClojure.core-test 'DrClojure.syntax-test)] (when (pos? (+ (:fail res) (:error res))) (System/exit 1)) (System/exit 0))"]}}}
